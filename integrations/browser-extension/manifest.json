{
  "manifest_version": 3,
  "name": "getcited: AI Search Visibility",
  "short_name": "getcited",
  "version": "1.1.0",
  "description": "Can ChatGPT, Perplexity and Google AI Overviews reach, read and quote this page? Audit and sentence X-ray in one click.",
  "homepage_url": "https://www.scairos.com/getcited",
  "action": {
    "default_title": "getcited: audit this page for AI search",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "minimum_chrome_version": "116",
  "browser_specific_settings": { "gecko": { "id": "getcited@scairos.com", "strict_min_version": "128.0" } }
}
